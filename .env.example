# ====================================================================
# GramAI Connect — Environment Variables
# Copy this file to .env.local and populate the values below.
# Never commit .env.local to GitHub or public version control.
# ====================================================================

# 1. PostgreSQL Database URL (Neon / Supabase / Local Postgres)
# Required for persisting complaints, documents, application journeys, and citizen records.
# Example: postgresql://username:password@ep-flat-thunder.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# 2. OpenRouter API Key (Official AI Brain)
# Official Portal: https://openrouter.ai/keys
# Obtain a key to enable real LLM reasoning, multilingual Q&A, and document extraction.
OPENROUTER_API_KEY=

# Default OpenRouter Model Identifier
# Recommended models:
# - meta-llama/llama-3.3-70b-instruct (Cost-effective, exceptional multilingual reasoning)
# - google/gemini-2.5-flash (Fast, multimodal with image/document support)
# - openai/gpt-4o-mini (Reliable, fast structured output)
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# 3. Sarvam AI API Key (Indian Language Speech & Voice)
# Official Portal: https://dashboard.sarvam.ai/
# Required for Telugu/Hindi/English Speech-to-Text (STT) and Text-to-Speech (TTS).
SARVAM_API_KEY=

# Optional: Sarvam STT model (default: saaras:v4)
SARVAM_STT_MODEL=saaras:v4

# Optional: Sarvam TTS model (default: bulbul:v3)
SARVAM_TTS_MODEL=bulbul:v3

# 4. Authentication Configuration
# AUTH_SECRET is used to sign session cookies (generate via: openssl rand -base64 32)
AUTH_SECRET=
# Application public URL used for OAuth callback redirection
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 5. Google OAuth 2.0 (Optional for Google Sign-in)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google (or your production domain)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

